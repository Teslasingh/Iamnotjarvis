# Copy to ".env" and fill in. Never commit ".env".
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
DEPLOYMENT_NAME=
OPENAI_API_VERSION=2024-12-01-preview

# Set a password before exposing the server on a network.
FRIDAY_PASSWORD=change-me
SESSION_SECRET=change-this-long-random-string

PORT=80
HOST=0.0.0.0
# Set to the repo root so soul.md lives alongside the project (recommended for self-modification).
# Example: AGENT_WORKDIR=C:\Users\tesla\Documents\Iamnotjarvis
AGENT_WORKDIR=
ALLOW_SHELL=true
MAX_AGENT_STEPS=32
LLM_TIMEOUT_SECONDS=90
LLM_RETRIES=3
EVENT_RING_MAX=500
# Unix: bash loads login profile (--login); set false for plain bash -c only.
FRIDAY_UNIX_LOGIN_SHELL=true

# Unix: background spawn uses a process group kill (SIGTERM children like npm/webpack).
FRIDAY_UNIX_KILL_BACKGROUND_GROUP=true

# Windows backend: powershell (default/pwsh) or cmd
FRIDAY_WINDOWS_SHELL=powershell

# Upload/output dirs are relative to AGENT_WORKDIR (or cwd when unset).
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs
OUTPUT_INLINE_MAX_BYTES=65536
OUTPUT_PREVIEW_IMAGE_MAX_BYTES=5242880

# Rewrite short/vague user prompts with an LLM before the agent turn (improves tool use & web search).
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_MIN_CHARS=12
QUERY_EXPANSION_MAX_INPUT_CHARS=1200

# Task analysis: intent, edge cases, and complexity routing (uses QUERY_EXPANSION_* gates).
TASK_ANALYSIS_ENABLED=true

# Multi-agent orchestration (only when task analysis recommends it).
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_SUBAGENTS=3
MULTI_AGENT_SUBAGENT_MAX_STEPS=16
MULTI_AGENT_SYNTHESIS_MAX_CHARS=12000

# Persistent long-term memory (soul.md at AGENT_WORKDIR root).
SOUL_ENABLED=true
SOUL_AUTO_UPDATE=true
SOUL_MAX_CONTEXT_CHARS=8000
SOUL_MAX_FILE_CHARS=32000

# Recent conversation memory (.friday/conversation.json at AGENT_WORKDIR).
CONVERSATION_MEMORY_ENABLED=true
CONVERSATION_MEMORY_MAX_TURNS=24
CONVERSATION_MEMORY_MAX_CONTEXT_CHARS=12000
CONVERSATION_MEMORY_CLEAR_ON_LOGOUT=false

# Azure OpenAI token usage tracking.
TOKEN_USAGE_ENABLED=true
TOKEN_USAGE_PERSIST=true
TOKEN_USAGE_CALL_LOG_MAX=200

# Allow FRIDAY_SELF_RESTART_ENABLED=true for restart_friday after self-edits.
FRIDAY_SELF_RESTART_ENABLED=false

# Autonomous Jarvis mode: durable task queue, auto-continuation, job follow-ups.
AUTONOMY_ENABLED=true
AUTONOMY_POLL_SECONDS=5
AUTONOMY_MAX_CONTINUATIONS=10
AUTONOMY_AUTO_CONTINUE=true
AUTONOMY_JOB_FOLLOWUP=true
AUTONOMY_QUEUE_USER_TASKS=true

# Watchdog: monitor all shell jobs and stop runaway/stuck processes; break agent continuation loops.
AUTONOMY_WATCHDOG_ENABLED=true
AUTONOMY_WATCHDOG_POLL_SECONDS=15
AUTONOMY_JOB_MAX_RUNTIME_SECONDS=7200
AUTONOMY_JOB_STALL_SECONDS=300
AUTONOMY_JOB_OUTPUT_LOOP_REPEATS=25
AUTONOMY_CONTINUATION_STALL_MAX=3
AUTONOMY_AGENT_STALL_MAX=8

# --- Hermes-style core (Phase 1) ---
# Comma-separated toolsets; empty = all (shell,filesystem,web,code,memory,output,meta,skills,delegation,code_exec)
FRIDAY_TOOLSETS_ENABLED=
SKILLS_ENABLED=true
FRIDAY_SKILLS_DIRS=
SKILLS_MAX_CATALOG_CHARS=4000
FRIDAY_SKILL_MAX_CHARS=24000
USER_MEMORY_ENABLED=true
AGENT_MEMORY_ENABLED=true
CONTEXT_FILES_ENABLED=true
CONTEXT_FILES_MAX_CHARS=12000
REFS_ENABLED=true
REFS_MAX_FILE_CHARS=16000
REFS_MAX_TOTAL_CHARS=48000
REFS_ALLOW_URL_FETCH=false
CHECKPOINTS_ENABLED=true
CHECKPOINTS_MAX_COUNT=20
CHECKPOINTS_MAX_FILE_BYTES=2000000

# --- Automation (Phase 2) ---
CRON_ENABLED=false
CRON_TICK_SECONDS=30
CRON_NL_PARSE_ENABLED=true
CRON_MAX_JOBS=50
DELEGATE_ENABLED=true
DELEGATE_MAX_PARALLEL=3
DELEGATE_MAX_TASKS_PER_CALL=5
DELEGATE_SUBAGENT_MAX_STEPS=16
CODE_EXEC_ENABLED=false
CODE_EXEC_MAX_SECONDS=30
CODE_EXEC_MAX_TOOL_CALLS=20
CODE_EXEC_ALLOWED_TOOLS=read_file,list_dir,search_code,run_shell
HOOKS_ENABLED=false
HOOKS_WEBHOOK_TIMEOUT_SECONDS=10
BATCH_ENABLED=false
BATCH_MAX_PARALLEL=3
BATCH_MAX_ITEMS=500
