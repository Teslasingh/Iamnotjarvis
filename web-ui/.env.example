OPENAI_ENDPOINT=https://api.openai.com/v1
OPENAI_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_ENDPOINT=https://api.anthropic.com

GOOGLE_API_KEY=

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

DEEPSEEK_ENDPOINT=https://api.deepseek.com
DEEPSEEK_API_KEY=

MISTRAL_API_KEY=
MISTRAL_ENDPOINT=https://api.mistral.ai/v1

OLLAMA_ENDPOINT=http://localhost:11434

ALIBABA_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=

MODELSCOPE_ENDPOINT=https://api-inference.modelscope.cn/v1
MODELSCOPE_API_KEY=

MOONSHOT_ENDPOINT=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=

UNBOUND_ENDPOINT=https://api.getunbound.ai
UNBOUND_API_KEY=

SiliconFLOW_ENDPOINT=https://api.siliconflow.cn/v1/
SiliconFLOW_API_KEY=

IBM_ENDPOINT=https://us-south.ml.cloud.ibm.com
IBM_API_KEY=
IBM_PROJECT_ID=

GROK_ENDPOINT="https://api.x.ai/v1"
GROK_API_KEY=

#set default LLM
DEFAULT_LLM=openai


# Set to false to disable anonymized telemetry
ANONYMIZED_TELEMETRY=false

# LogLevel: Set to debug to enable verbose logging, set to result to get results only. Available: result | debug | info
BROWSER_USE_LOGGING_LEVEL=info

# Browser settings
BROWSER_PATH=
BROWSER_USER_DATA=
BROWSER_DEBUGGING_PORT=9222
BROWSER_DEBUGGING_HOST=localhost
# Set to true to keep browser open between AI tasks
KEEP_BROWSER_OPEN=true
USE_OWN_BROWSER=false
BROWSER_CDP=
# Display settings
# Format: WIDTHxHEIGHTxDEPTH
RESOLUTION=1920x1080x24
# Width in pixels
RESOLUTION_WIDTH=1920
# Height in pixels
RESOLUTION_HEIGHT=1080

# VNC settings
VNC_PASSWORD=youvncpassword

# OCR (pytesseract) — improves form filling and reading on-screen labels
OCR_ENABLED=true
JOB_APPLICATION_MODE=true
HTML_INSPECT_ENABLED=true
# HTML_INSPECT_MAX_CHARS=4500
# HTML_INSPECT_DEEP_MAX_CHARS=12000
# Required on Windows if tesseract is not on PATH (install UB Mannheim build first):
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# OCR_MIN_CONFIDENCE=35
# OCR_MAX_CHARS=3500

# Unified scrape pipeline — fast mode skips redundant work between steps
PAGE_SCRAPE_PARALLEL=true
PAGE_SCRAPE_FAST=true
OCR_STEP_INTERVAL=4
HTML_INSPECT_FAST_MAX_CHARS=2800
# false = no second full scrape after each action (next step scrapes once)
FAST_POST_ACTION_RESCRAPE=false

# browser-use state capture (screenshot + DOM index). Retries help on SPAs/modals.
BROWSER_STATE_MAX_RETRIES=3
BROWSER_STATE_RETRY_DELAY_S=0.5
BROWSER_STATE_FAST_DOM_ON_RETRY=true
BROWSER_DEFAULT_TIMEOUT_MS=90000
BROWSER_SCREENSHOT_LOAD_TIMEOUT_MS=15000
# Skip network-idle wait before each step (recommended for LinkedIn and other SPAs)
BROWSER_SKIP_NETWORK_IDLE_WAIT=true

# Scroll: smaller steps (0.35 = 35% viewport); auto-scroll during briefing is off by default
SCROLL_STEP_FRACTION=0.35
AUTO_SCROLL_ON_BRIEFING=false

# Search / job listings: wait for results, then full DOM + OCR scrape (not fast-skip)
SEARCH_SETTLE_WAIT_S=2.5
SEARCH_FULL_SCRAPE=true

# Session memory across steps/runs (tmp/webui_session/job_session.json)
JOB_SESSION_CONTEXT=true
JOB_SESSION_INJECT_INTERVAL=1

# Learn from manual clicks/scrolls/navigation while the agent runs
USER_LEARNING_ENABLED=true
USER_LEARNING_SCROLL_THRESHOLD_PX=80

# LLM synthesis of manual corrections into durable preference rules
USER_PREFERENCE_SYNTHESIS_ENABLED=true
USER_PREFERENCE_SYNTHESIS_MIN_EVENTS=3
USER_PREFERENCE_MAX_RULES=15
# USER_PREFERENCE_FILE=tmp/webui_session/user_preferences.json
